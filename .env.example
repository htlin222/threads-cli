# Copy to .env and fill in. Never commit the real .env.
#
# From Meta App Dashboard (https://developers.facebook.com/apps/)
# -> Use Cases -> Access the Threads API -> Customize -> Settings
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=

# The redirect URI registered in the same Threads API settings page.
# Must be HTTPS and match EXACTLY (no trailing slash drift).
# Cloudflare route:  https://<your-worker>.workers.dev/callback  (after `make worker-deploy`)
# GitHub Pages route: https://<user>.github.io/<repo>/          (then use `make auth-manual`)
THREADS_REDIRECT_URI=
# Worker base URL -- ONLY for the Cloudflare route (`make auth` polls it).
# Leave blank if you use the GitHub Pages + `make auth-manual` route.
THREADS_WORKER_BASE=

# Populated automatically by `make auth` / `make refresh` -- leave empty on first run.
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_TOKEN_EXPIRES_AT=
